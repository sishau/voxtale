[Unit]
Description=Heartale TTS audiobook web service
After=network.target

[Service]
Type=simple
User=your_username
WorkingDirectory=%h/workspace/heartale
ExecStart=%h/workspace/heartale/venv/bin/python %h/workspace/heartale/app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
